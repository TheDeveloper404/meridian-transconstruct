# Copiază în .env.local (dezvoltare) sau setează în mediul serverului (producție).
# Nu pune niciodată valori reale în acest fișier sau în git.

# --- Site ---
# URL-ul canonic folosit în metadata și sitemap (fără slash final).
SITE_URL=https://meridian-transconstruct.ro
# Indexarea Google e oprită implicit; se pune true doar la lansare, pe producție.
ALLOW_INDEXING=false
# Codul de verificare Google Search Console (metoda „etichetă HTML”, doar valoarea din content="...").
GOOGLE_SITE_VERIFICATION=

# --- Formular de contact (SMTP) ---
# Fără SMTP_HOST / SMTP_USER / SMTP_PASSWORD / CONTACT_MAIL_FROM / CONTACT_MAIL_TO,
# formularul răspunde 503 „indisponibil” și afișează alternativa telefonică.
SMTP_HOST=
# 587 = STARTTLS (implicit), 465 = TLS implicit.
SMTP_PORT=587
# Opțional: true/false; implicit true doar pentru portul 465.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Expeditor autentificat la furnizorul SMTP, ex.: Meridian Transconstruct <site@domeniu.ro>
CONTACT_MAIL_FROM=
# Inboxul care primește cererile (temporar adresa Yahoo din brief, B-009).
CONTACT_MAIL_TO=

# --- Anti-abuz ---
# Cereri acceptate per client într-o fereastră (implicit 5 / 60 minute).
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MINUTES=60
# true DOAR în spatele unui reverse proxy (nginx) care setează X-Real-IP / X-Forwarded-For.
# Altfel toate cererile împart o singură limită globală.
TRUST_PROXY=false
